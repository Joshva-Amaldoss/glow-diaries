DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-long-random-string-in-production"

# Admin account (created/updated by npm run db:seed)
ADMIN_EMAIL="your-email@example.com"
ADMIN_PASSWORD="Admin123!"

# OpenAI Vision (optional — enables AI face analysis on photo upload)
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o-mini"

# Email (optional — logs to console if SMTP not set)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Glow Diaries <noreply@glowdiaries.com>"
